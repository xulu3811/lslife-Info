// 连山同城 LsLife 数据模型
// 本地开发使用 SQLite (零配置可运行); 生产切换 provider = "postgresql"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= 账户与鉴权 =================
model User {
  id                  String    @id @default(cuid())
  phone               String    @unique
  email               String?   @unique
  passwordHash        String? // 手机号+密码登录；bcrypt 哈希，可空兼容历史短信用户
  nickname            String
  avatar              String?
  membershipTier      String    @default("free") // free | vip | premium
  membershipUntil     DateTime?
  status              String    @default("active") // active | banned
  realNameStatus      String    @default("none") // none | pending | verified
  realName            String?
  idCardHash          String? // 实名身份证仅存哈希
  idCardFrontImage    String? // 身份证正面照
  idCardBackImage     String? // 身份证反面照
  idCardHandheldImage String? // 手持身份证照
  walletBalance       Float     @default(0)
  points              Int       @default(0)
  followersCount      Int       @default(0) // 新增：我的关注/粉丝数
  favoritesCount      Int       @default(0) // 新增：我的收藏数
  footprintsCount     Int       @default(0) // 新增：浏览足迹数
  identityType        String    @default("NORMAL") // 新增：身份认证类型 (NORMAL, LANDLORD, HR, etc.)
  creditScore         Int       @default(100) // 新增：信用评价分
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  addresses      Address[]
  orders         Order[]             @relation("BuyerOrders")
  soldOrders     Order[]             @relation("SellerOrders")
  cartItems      CartItem[]
  soldCartItems  CartItem[]          @relation("CartSeller")
  posts          Post[]
  notifications  Notification[]
  subscriptions  Subscription[]
  transactions   WalletTransaction[]
  ownedMerchants Merchant[]          @relation("MerchantOwner")
  merchantCertification MerchantCertification?
  wallet         UserWallet?
  walletLogs     WalletLog[]
}

model MerchantCertification {
  id                 String   @id @default(cuid())
  userId             String   @unique
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  certType           String   @default("ENTERPRISE") // ENTERPRISE | INDIVIDUAL
  storeName          String
  categoryId         String
  contactName        String
  contactPhone       String
  businessLicenseUrl String?
  storePhotos        String   @default("[]") // JSON string array of URLs
  rejectReason       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("login") // login | bind
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  tag       String   @default("家")
  address   String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= 商家与商品 =================
model Merchant {
  id            String   @id @default(cuid())
  externalId    String?  @unique // 兼容原型中的 m1/m2...
  name          String
  rating        Float    @default(5)
  distance      Float    @default(0)
  sales         Int      @default(0)
  avgPrice      Float    @default(0)
  tags          String   @default("[]") // JSON 字符串数组
  deliveryFee   Float    @default(0)
  deliveryTime  Int      @default(30)
  logo          String
  banner        String
  isFood        Boolean  @default(false)
  category      String?
  latitude      Float
  longitude     Float
  description   String
  address       String
  phone         String
  status        String   @default("active") // active | offline | pending
  walletBalance Float    @default(0) // 商户可提现余额
  ownerId       String? // 店铺归属用户
  createdAt     DateTime @default(now())

  products     Product[]
  orders       Order[]
  posts        Post[]
  transactions WalletTransaction[]
  owner        User?               @relation("MerchantOwner", fields: [ownerId], references: [id])
}

model Product {
  id            String  @id @default(cuid())
  externalId    String? @unique
  merchantId    String
  name          String
  price         Float
  originalPrice Float?
  desc          String
  sales         Int     @default(0)
  image         String
  category      String
  rating        Float?
  stock         Int     @default(999)
  status        String  @default("active")

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([merchantId])
}

// ================= 购物车 =================
model CartItem {
  id         String   @id @default(cuid())
  userId     String
  productId  String? // Made optional for polymorphic
  postId     String? // Added for C2C
  merchantId String? // Made optional for polymorphic
  sellerId   String? // Added for C2C (User ID of post publisher)
  quantity   Int      @default(1)
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  seller  User?    @relation("CartSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  // A cart item should either be a product or a post, handled in logic. No strict DB unique on both since one is null.
  @@index([userId])
}

// ================= 订单与支付 =================
model Order {
  id              String    @id @default(cuid())
  orderNo         String    @unique
  userId          String
  merchantId      String? // Made optional
  sellerId        String? // Added for C2C
  merchantName    String? // Actually this acts as shopName/sellerName
  merchantLogo    String? // avatar or logo
  itemsTotal      Float
  deliveryFee     Float     @default(0)
  totalAmount     Float
  status          String    @default("pending") // pending | paid | preparing | delivering | delivered | cancelled
  deliveryMethod  String    @default("DELIVERY") // DELIVERY | PICKUP
  pickupTime      String?
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  user         User                @relation("BuyerOrders", fields: [userId], references: [id])
  seller       User?               @relation("SellerOrders", fields: [sellerId], references: [id])
  merchant     Merchant?           @relation(fields: [merchantId], references: [id])
  items        OrderItem[]
  payment      Payment?
  delivery     Delivery?
  transactions WalletTransaction[]

  @@index([userId])
  @@index([merchantId])
  @@index([sellerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // Optional
  postId    String? // Optional
  name      String
  price     Float
  quantity  Int
  image     String

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])

  @@index([orderId])
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  provider       String // wechat | alipay | wallet | mock
  amount         Float
  pointsUsed     Int       @default(0)
  pointsDiscount Float     @default(0)
  cashAmount     Float     @default(0)
  status         String    @default("created") // created | success | failed | refunded
  transactionId  String? // 第三方支付流水号
  prepayPayload  String? // 客户端拉起支付所需参数 (JSON)
  createdAt      DateTime  @default(now())
  paidAt         DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ================= 资金流水 =================
model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  merchantId    String?
  type          String // points | cash
  amount        Float // 正数表示收入，负数表示支出
  balanceBefore Float
  balanceAfter  Float
  bizType       String // recharge | order_pay | order_refund | settlement
  orderId       String?
  description   String?
  createdAt     DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([merchantId])
}

// ================= 实时配送 =================
model Delivery {
  id          String   @id @default(cuid())
  orderId     String   @unique
  riderName   String
  riderPhone  String
  riderAvatar String?
  riderLat    Float
  riderLng    Float
  progress    Int      @default(0)
  status      String   @default("preparing")
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ================= 分类与动态表单 =================
model Category {
  id              String  @id @default(cuid())
  name            String
  icon            String? // 兼容客户端旧的 icon 字段
  iconUrl         String? // 新增：层级目录图标 URL
  parentId        String? // 引用父级 ID (nullable, referencing Category.id)
  sortOrder       Int     @default(0)
  isLeaf          Boolean @default(false)
  isActive        Boolean @default(true) // 新增：是否启用
  isHot           Boolean @default(false) // 新增：是否为热门推荐
  tradeMode       String  @default("INFO") // 新增：INFO 或 COMMERCE
  attributeSchema String? @default("[]") // JSON 字符串数组 DynamicField[]

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")
  posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@index([isHot])
}

// ================= 同城发布 =================
model Post {
  id            String   @id @default(cuid())
  userId        String
  publisherType String   @default("INDIVIDUAL") // INDIVIDUAL | MERCHANT
  merchantId    String?
  listingType   String   @default("GOODS") // GOODS | SERVICE
  tradeMode     String   @default("INFO") // 新增：数据归属流向 (INFO / COMMERCE)
  category      String
  categoryId    String?
  title         String
  description   String
  price         Float?
  originalPrice Float?   // 新增：划线原价
  contactPhone  String?  // 新增：信息直连电话
  stock         Int      @default(0)   // 新增：真实电商库存
  deliveryType  String   @default("SELF_PICKUP") // 新增：配送方式
  images        String   @default("[]") // JSON 字符串数组
  latitude      Float?
  longitude     Float?
  locationName  String?
  attributes    String   @default("{}") // JSON 动态属性
  status        String   @default("published") // pending_review | published | rejected | removed
  reviewNote    String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant    Merchant?   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryRel Category?   @relation(fields: [categoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([userId])
  @@index([category])
  @@index([categoryId])
  @@index([status, category]) // 新增复合索引加速搜索
  @@index([status, price])    // 新增复合索引加速价格过滤
}

// ================= 会员订阅 =================
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  tier      String // vip | premium
  amount    Float
  startAt   DateTime @default(now())
  endAt     DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= 消息通知 =================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // merchant_accept | preparing | delivering | delivered | system
  title     String
  content   String
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= 实时聊天 =================
model ChatSession {
  id          String   @id @default(cuid())
  user1Id     String
  user2Id     String
  lastMessage String?
  unread1     Int      @default(0) // user1 的未读数
  unread2     Int      @default(0) // user2 的未读数
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  messages ChatMessage[]

  @@unique([user1Id, user2Id]) // 确保两人间只有一个会话
}

model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  senderId     String
  type         String   @default("text") // text | image | recalled | system
  content      String
  isRecalled   Boolean  @default(false)
  isEncrypted  Boolean  @default(true)
  evidenceHash String? // SHA-256 密码学防篡改存证链哈希
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

// ================= 管理后台 =================
model AdminUser {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String // Hash
  role      String    @default("admin") // superadmin | admin | editor | auditor
  lastLogin DateTime?
  lastIp    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ================= 系统配置 =================
model SystemConfig {
  key       String   @id // e.g., "merchant_require_approval"
  value     String // e.g., "true" or "false"
  updatedAt DateTime @updatedAt
}

// ================= 虚拟货币钱包系统 =================
model UserWallet {
  userId        String   @id // 引用自 User.id
  coinBalance   Int      @default(0) // 猫币余额
  totalRecharged Float   @default(0.00) // 累计充值 (RMB)
  version       Int      @default(0) // 乐观锁版本号
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletLog {
  id            String   @id @default(cuid())
  userId        String
  amount        Int      // 变动数量 (正负值)
  balanceAfter  Int      // 变动后余额快照
  tradeType     String   // RECHARGE, REWARD, CONSUME_TOP, CONSUME_POST 等
  relatedBizId  String?  // 关联业务 ID
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model RechargePackage {
  id          Int      @id @default(autoincrement())
  price       Float    // RMB 售价
  coinsAmount Int      // 基础猫币数量
  bonusCoins  Int      @default(0) // 赠送猫币
  isActive    Boolean  @default(true) // 是否上架
}
